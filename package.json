{
  "name": "run-and-local",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "node --experimental-strip-types tests/routing.ts public/data/gangneung.json && node --experimental-strip-types tests/records.ts && node --experimental-strip-types tests/session.ts && node --experimental-strip-types tests/terrain.ts && node --experimental-strip-types --experimental-test-module-mocks tests/navigation.ts",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "sync:mobile": "npm run build:mobile && cap sync",
    "dev:mobile": "vite --config vite.mobile.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.1",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@cloudflare/vite-plugin": "^1.54.8",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "^1.9.20",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  },
  "type": "module"
}
